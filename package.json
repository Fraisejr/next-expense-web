{
  "name": "next-expense-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "import:ios": "node scripts/import-ios.mjs",
    "import:ios:archive": "node scripts/import-ios-archive.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:server": "node --experimental-transform-types --test server/*.test.ts",
    "test:ios-callback": "node scripts/test-ios-callback.mjs",
    "test:auth": "node --experimental-strip-types scripts/test-auth-bootstrap.mjs",
    "test:bank-policy": "node --experimental-strip-types scripts/test-bank-import-policy.mjs"
  },
  "dependencies": {
    "@neondatabase/neon-js": "^0.7.0-beta",
    "@vitejs/plugin-react": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-router-dom": "^7.18.3",
    "typescript": "latest",
    "vite": "latest",
    "@supabase/postgrest-js": "2.79.0"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@types/node": "^26.4.1",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint": "latest",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-react-refresh": "latest",
    "globals": "latest",
    "typescript-eslint": "latest"
  },
  "engines": {
    "node": "22.x"
  }
