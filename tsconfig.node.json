{
  "compilerOptions": {
    "composite": true,
    "noEmit": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022"
  },
  "include": [
    "vite.config.ts",
    "server/**/*.ts",
    "api/**/*.ts",
    "shared/**/*.ts",
    "src/types.ts",
    "src/bank-import-policy.ts"
  ]
}
