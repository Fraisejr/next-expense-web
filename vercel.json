{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/gocardless/[action].ts": {
      "maxDuration": 300
    },
    "api/cron/bank-sync.ts": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/cron/bank-sync",
      "schedule": "0 5 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/.well-known/oauth-protected-resource/api/mcp",
      "destination": "/api/mcp-oauth?mcp_route=resource"
    },
    {
      "source": "/.well-known/oauth-protected-resource",
      "destination": "/api/mcp-oauth?mcp_route=resource"
    },
    {
      "source": "/.well-known/oauth-authorization-server",
      "destination": "/api/mcp-oauth?mcp_route=metadata"
    },
    {
      "source": "/.well-known/openid-configuration",
      "destination": "/api/mcp-oauth?mcp_route=openid"
    },
    {
      "source": "/api/mcp-oauth/:action",
      "destination": "/api/mcp-oauth?mcp_route=:action"
    },
    {
      "source": "/auth/ios/callback",
      "destination": "/auth/ios/callback.html"
    },
    {
      "source": "/((?!api/|auth/ios/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/auth/ios/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'none'; script-src 'self'; style-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
        }
      ]
    }
  ]
}
