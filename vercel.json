{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": { "api/gocardless/[action].ts": { "maxDuration": 60 } },
  "rewrites": [
    { "source": "/auth/ios/callback", "destination": "/auth/ios/callback.html" },
    { "source": "/((?!api/|auth/ios/).*)", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/auth/ios/:path*", "headers": [
      { "key": "Cache-Control", "value": "no-store" },
      { "key": "Referrer-Policy", "value": "no-referrer" },
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Content-Security-Policy", "value": "default-src 'none'; script-src 'self'; style-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'" }
    ] }
  ]
}
